# ============ AI 服务（服务端专用，切勿提交真实值）============
# 可选值：zhipu（默认，免费）| deepseek（需充值）| 自定义地址
AI_PROVIDER=zhipu

# API 密钥：智谱在 https://open.bigmodel.cn/usercenter/apikeys 获取
AI_API_KEY=

# 可选：覆盖接口地址，例如改用其他 OpenAI 兼容服务
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 可选：覆盖模型名，例如 glm-4-flash（128K 上下文，同样免费）
# AI_MODEL=glm-4.7-flash

# 旧变量名 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL 仍然兼容，
# 但建议统一改成上面的 AI_* 写法。

# ---------- 可选：备用供应商（主供应商抽风时自动顶上）----------
# 免费额度天然会一阵一阵地抽风，配一个备用可以显著降低演示翻车的概率。
# 三条必须同时填写才会启用；只填一部分会当作没配，不会发到错误的地址。
# 备用供应商不做厂商特判，所以任何 OpenAI 兼容服务都能填。
# AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_MODEL=

# ============ 语音识别（服务端专用，切勿提交真实值）============
# 语音输入走 Groq 的 whisper-large-v3-turbo（免费 2000 次/天、20 次/分钟）。
# 默认直接复用备用 AI 的 Groq Key（AI_FALLBACK_API_KEY），配好备用 AI 语音即可用，
# 不需要单独申请；想在语音上单独用一把 Key 时才填下面这条（可选）。
# ASR_API_KEY=
# 可选：覆盖语音识别的接口地址（默认与备用 AI 同一家）
# ASR_BASE_URL=https://api.groq.com/openai/v1

# ============ Supabase（登录与数据持久化）============
# 这两个变量带 NEXT_PUBLIC_ 前缀是故意的：Supabase 的 publishable key
# 设计上就会发给浏览器，安全靠行级安全策略（RLS）保证，不靠藏密钥。
# 绝对不要填 service_role / secret key——那个会绕过 RLS，等于数据库裸奔。
# 未配置时应用仍可正常使用对话与纠错（只是不保存历史）。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
